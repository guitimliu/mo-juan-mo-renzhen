# 複製此檔為 .env 並填入你自己的值：cp .env.example .env
#
# .env 內含真實憑證，已被 .gitignore 忽略，請勿提交到版控。

# ---- AWS 區域 ----
AWS_DEFAULT_REGION=us-west-2

# ---- AWS 憑證 ----
# 臨時憑證（ASIA 開頭）需要同時填 SESSION_TOKEN；長期憑證（AKIA 開頭）則不需要。
AWS_ACCESS_KEY_ID=你的_access_key_id
AWS_SECRET_ACCESS_KEY=你的_secret_access_key
AWS_SESSION_TOKEN=你的_session_token

# ---- Bedrock AgentCore harness ----
HARNESS_ARN=arn:aws:bedrock-agentcore:us-west-2:833864702926:harness/harness_jstj4-CRUo6K5B8U

# 對話 session id（可留空，程式會自動產生）
# RUNTIME_SESSION_ID=
