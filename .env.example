# docker compose 用：cp .env.example .env 後改；.env 不會進 git。
# ======== 共用 ========
ADAPTER=stub                 # stub＝離線示範（正本改寫，非 AI）；bedrock＝真的走 AWS Bedrock（下面 AWS 段必填）
STUB_STAGE_DELAY_S=1.5       # stub 模式每階段模擬延遲（秒）；bedrock 模式忽略
FRONTEND_PORT=8080           # nginx 對外埠（雲端部署建議 80）
BACKEND_PORT=8000            # 後端直連埠（只給 curl／除錯；前端走 nginx 同源 /api，不需要開對外）
# CORS_ORIGINS=http://localhost:8080,http://localhost:5173   # 只有前端跨網域直打後端時才要改；經 nginx 同源代理用不到

# ======== Bedrock 模式（ADAPTER=bedrock 才需要）========
# 方式 A：EC2 掛 IAM instance profile（建議）→ 三個 AWS_* 留空，boto3 自動取用。
# 方式 B：主辦方臨時憑證（ASIA…，數小時過期）→ 填三個 AWS_*；過期後重填並 docker compose up -d --force-recreate backend
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_REGION=us-west-2   # 也可用 AWS_DEFAULT_REGION；KB 與 inference profile 都在 us-west-2
# BEDROCK_KB_ID=ZOMMOWFOT2   # Knowledge Base（見 backend/README.md「Knowledge Base」）
# ---- 模型（都有預設，通常不用改；Claude 要用 us. 開頭的 inference profile）----
# BEDROCK_OCR_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_EXTRACT_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_RETRIEVAL_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_GENERATE_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_OCR_MAX_TOKENS=4096
# BEDROCK_GENERATE_MAX_TOKENS=6000
# MAX_UPLOAD_BYTES=10485760  # 單張影像上限（nginx client_max_body_size 25m 已對應兩張）
